# Absolute path or path relative to this project. Quote paths containing spaces.
MEDIA_ROOT=./media

# Server settings (loaded by npm start and npm run dev).
APP_HOST=0.0.0.0
APP_PORT=3042
# Comma-separated hostnames/IPs for development through a proxy; no URL schemes.
DEV_ALLOWED_HOSTS=

# Writable storage, separate from the read-only artwork directory.
DATA_DIR=./data
CACHE_DIR=./.cache
TIMELAPSE_CACHE_GB=2
# How often visits trigger a background check for new/changed/deleted artworks.
CATALOG_REFRESH_SECONDS=60

# Optional tagging: none | ram++ | custom. Existing saved tags remain searchable.
TAGGING_ENGINE=none
# Python executable on PATH, or an absolute path into your virtual environment.
TAGGER_PYTHON=python3
# Custom engine only: Python file exporting create_tagger(). See docs/tagging.md.
TAGGER_PLUGIN=

# RAM++ only. Install the optional Python environment and cache model files first.
RAM_DEVICE=auto
RAM_THREADS=4
# Optional local checkpoint; blank uses the model in the Hugging Face cache.
RAM_CHECKPOINT=
# Optional Hugging Face cache directory; blank uses its standard location.
# HF_HOME=/path/to/model-cache
